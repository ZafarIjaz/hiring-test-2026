rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function getUserClinicId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId;
    }

    function isOwner() {
      return isAuthenticated() && getUserRole() == 'owner';
    }

    function isStaffForClinic(clinicId) {
      return isAuthenticated() &&
        belongsToClinic(clinicId) &&
        isSeatActive(clinicId, request.auth.uid) &&
        (getUserRole() == 'staff' || getUserRole() == 'owner');
    }

    function belongsToClinic(clinicId) {
      return isAuthenticated() &&
        getUserClinicId() == clinicId;
    }

    function isSeatActive(clinicId, userId) {
      return exists(/databases/$(database)/documents/seats/$(clinicId)/members/$(userId)) &&
        get(/databases/$(database)/documents/seats/$(clinicId)/members/$(userId)).data.active == true;
    }

    function getClinicPlan(clinicId) {
      return get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.plan;
    }

    function getClinicSubStatus(clinicId) {
      return get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.status;
    }

    function clinicAllowsSeatGrowth(clinicId) {
      let clinic = get(/databases/$(database)/documents/clinics/$(clinicId)).data;
      return getClinicSubStatus(clinicId) == 'active' &&
        clinic.seats.used < clinic.seats.max;
    }

    function hasExtraStorageAddon(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data.extraStorage == true;
    }

    function isPremiumOrHigher(clinicId) {
      let plan = getClinicPlan(clinicId);
      return plan == 'premium' || plan == 'vip';
    }

    // Clinics collection
    match /clinics/{clinicId} {
      allow read: if isAuthenticated() && belongsToClinic(clinicId);
      allow create: if isAuthenticated(); // Owner creates clinic on signup
      allow update: if isOwner() && belongsToClinic(clinicId);
      allow delete: if false; // Clinics are never deleted via client
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile; owners can read their clinic members
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isOwner()
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isOwner() // Owner can update roles
      );
      allow delete: if false;
    }

    // Subscriptions
    match /subscriptions/{clinicId} {
      allow read: if isAuthenticated() && belongsToClinic(clinicId);
      allow write: if false;
    }

    // Add-ons
    match /addons/{clinicId}/items/{addonId} {
      allow read: if isAuthenticated() && belongsToClinic(clinicId);
      allow write: if false;
    }

    // Discounts — readable by owners to display in billing UI
    match /discounts/{discountId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Appointments
    match /appointments/{appointmentId} {
      function requestClinicId() {
        return request.method == 'create' ? request.resource.data.clinicId : resource.data.clinicId;
      }

      function canWriteAppointment() {
        let clinicId = requestClinicId();
        let hasAttachments = 'attachments' in request.resource.data && request.resource.data.attachments.size() > 0;
        return isStaffForClinic(clinicId) &&
          (
            !hasAttachments ||
            hasExtraStorageAddon(clinicId)
          ) &&
          (
            !('analyticsSnapshot' in request.resource.data) ||
            isPremiumOrHigher(clinicId)
          );
      }

      allow read: if isAuthenticated() && (
        // Staff and owners see all clinic appointments
        isStaffForClinic(resource.data.clinicId) ||
        // Patients see only their own
        resource.data.patientId == request.auth.uid
      );

      allow create: if canWriteAppointment(); // Staff/owner books appointments
      allow update: if canWriteAppointment() &&
        request.resource.data.clinicId == resource.data.clinicId; // clinic is immutable
      allow delete: if isOwner() && isStaffForClinic(resource.data.clinicId);
    }

    // Seats
    match /seats/{clinicId}/members/{userId} {
      allow read: if isAuthenticated() && belongsToClinic(clinicId);

      allow create: if isOwner() &&
        belongsToClinic(clinicId) &&
        request.resource.data.active == true &&
        clinicAllowsSeatGrowth(clinicId);

      allow update: if isOwner() &&
        belongsToClinic(clinicId) &&
        (
          // Deactivation is always allowed.
          (resource.data.active == true && request.resource.data.active == false) ||
          // Activation requires active subscription and free capacity.
          (resource.data.active == false && request.resource.data.active == true && clinicAllowsSeatGrowth(clinicId)) ||
          // Metadata-only updates (no active flip).
          (resource.data.active == request.resource.data.active)
        );

      allow delete: if false;
    }
  }
}
